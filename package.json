{
  "name": "1page",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "playwright test tests/visual",
    "a11y": "playwright test tests/e2e/a11y.spec.ts",
    "e2e": "playwright test tests/e2e",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/db-types.mjs",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-push.mjs --seed",
    "db:status": "node scripts/db-push.mjs --status",
    "gen:slug": "node scripts/gen-slug.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "admin:list": "node scripts/admin-create.mjs --list"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10",
    "jsdom": "^30.0.1",
    "prettier": "^3",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
