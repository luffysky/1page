# ============================================================================
# 複製此檔為 .env.local 後填入實際值。
#
# .env.local 已被 .gitignore 忽略，不會進版控——請保持這樣。
# 標示【SECRET】的變數等同管理員權限，絕不可加 NEXT_PUBLIC_ 前綴，
# 因為那會讓它被打包進瀏覽器端的 JavaScript。
#
# 「需要階段」欄說明何時才真的用得到；未到該階段可留空。
# ============================================================================


# ── Supabase ────────────────────────────────────────────── 需要階段：Phase 2 起
#
# Zeabur 自架版：Supabase 服務的對外網址與 Kong 簽發的 JWT。
# 三個值都可在 Zeabur 專案的環境變數中找到。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 【SECRET】可繞過所有 RLS，並可透過 /pg/query 執行任意 SQL。
# 僅用於：migration（pnpm db:push）、型別產生（pnpm db:types）、
# 以及 server 端的管理操作。永遠不要送到瀏覽器。
SUPABASE_SERVICE_ROLE_KEY=


# ── 站台網址 ──────────────────────────────────────────── 需要階段：部署時
#
# canonical 與 OG 需要絕對網址。未設定時退回 http://localhost:3000。
# 刻意不預設成 production 網域——那會讓開發時的 OG 預覽指向線上頁面。

NEXT_PUBLIC_SITE_URL=


# ── Cloudflare R2（物件儲存）──────────────────────────── 需要階段：Phase 2F
#
# CR-001：媒體儲存改用 R2（Spec V1.2 §8.9）。
#
# ⚠️ R2 沒有 RLS。資料庫那側的 policy 保護不到物件儲存，
# 上傳授權只剩自家 server route 把關：
#   - 前端絕不持有 access key
#   - presigned URL 由 server 簽發，簽發前先驗證 admin 身分
#   - bucket 不可開放公開列舉（list）

# 建立 R2 API token 時 Cloudflare 會顯示三個值，我們只用其中兩個：
#
#   權杖值 (Token value)          ✗ 不需要。那是 Cloudflare 自家 R2 REST API 用的，
#                                   我們走 S3 相容 API
#   存取金鑰識別碼 (Access Key ID) ✓ → R2_ACCESS_KEY_ID
#   秘密存取金鑰 (Secret Key)      ✓ → R2_SECRET_ACCESS_KEY
#
# 建立 token 時權限選「物件讀寫」並限定到單一 bucket，不要給帳號層級 Admin。
# 這把金鑰只用來在 server 端簽 presigned URL，不需要建立或刪除 bucket 的能力。

# 取自同一頁的 S3 端點：https://<這一段>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# 【SECRET】
R2_ACCESS_KEY_ID=
# 【SECRET】
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 公開讀取用的網域。這個值是公開的，因此可以有 NEXT_PUBLIC_ 前綴。
#
# 建議綁自訂網域而非使用 r2.dev：r2.dev 有速率限制且不建議正式使用，
# 綁自訂網域才能在前面掛 Cloudflare 的快取與規則。
NEXT_PUBLIC_R2_PUBLIC_URL=


# ── Anthropic API ────────────────────────────────────────── 需要階段：Phase 5
#
# AI Website Advisor（Spec §16）。
# 【SECRET】只在 server 端的 /api/agent 使用。

ANTHROPIC_API_KEY=


# ── 選用 ─────────────────────────────────────────────────────────────────────

# 一次性：建立管理員帳號用（pnpm admin:create）。
# 建好之後就可以從這裡移除。
ADMIN_EMAIL=
# 【SECRET】
ADMIN_PASSWORD=
